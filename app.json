{
  "expo": {
    "name": "MoodBoard",
    "slug": "moodboard-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/MoodBoard_Design.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/MoodBoard_Design.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C6FFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moodboard.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/MoodBoard_Design.png",
        "backgroundColor": "#7C6FFF"
      },
      "package": "com.moodboard.app"
    },
    "web": {
      "favicon": "./assets/MoodBoard_Design.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/MoodBoard_Design.png",
          "color": "#7C6FFF",
          "androidMode": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MoodBoard uses your location to show your position on the map for your connected friends and family.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "moodboard",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b60c2f4e-85e7-47c3-8657-b925efeb96d6"
      }
    },
    "owner": "ahsanabbas"
  }
}
